# === ЭТАП 1: Сборка Vite-проекта через Deno ===
FROM denoland/deno:alpine AS builder

WORKDIR /app

# 1. Копируем конфигурацию и lockfile для кэширования слоёв
COPY deno.json deno.lock* tsconfig*.json ./

# Кэшируем зависимости (если используется deno.lock или импорты)
RUN deno install || true

# 2. Копируем исходный код
COPY . .

# 3. Передаём переменные сборки (если фронтенд ходит на /api или относительные пути)
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

# 4. Собираем продакшн-билд (генерирует /app/dist)
RUN deno task build

# === ЭТАП 2: Отдаём статику через nginx ===
FROM nginx:alpine

# Очищаем дефолтную статику Nginx
RUN rm -rf /usr/share/nginx/html/*

# Копируем скомпилированную статику
COPY --from=builder /app/dist /usr/share/nginx/html

# Копируем оптимизированный конфиг для SPA
COPY ./nginx-spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]