# === ЭТАП 1: Сборка Vite-проекта через Deno ===
FROM denoland/deno:alpine AS builder

WORKDIR /app

# Кэшируем зависимости
COPY deno.json tsconfig.json ./
RUN deno cache deno.json

# Копируем весь код
COPY . .

# Собираем продакшн-билд (это создаст папку dist)
RUN deno task build

# === ЭТАП 2: Отдаём статику через nginx ===
FROM nginx:alpine

# Копируем собранные файлы
COPY --from=builder /app/dist /usr/share/nginx/html

# Специальный nginx.conf для SPA (все маршруты → index.html)
COPY ./nginx-spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80